{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "css.lint.unknownAtRules": "ignore",
  "scripts": {
    "dev": "concurrently -n vite,py -c cyan,magenta \"vite\" \"node scripts/start-printer.cjs\"",
    "dev:vite": "vite",
    "dev:py": "node scripts/start-printer.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@point-of-sale/receipt-printer-encoder": "^4.0.1",
    "@supabase/supabase-js": "^2.57.4",
